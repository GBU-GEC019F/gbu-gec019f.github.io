  "narrative": {
    "northStar": "Course exhibition",
    "overview": "A quiet university exhibition catalog: warm paper, generous serif headlines, thin rules and useful links make student work the focus. The deep olive publication folio closes the page with practical guidance. Identity is typographic; no university logo is invented.\n\nThis records the implementation in `index.html`, `styles.css` and `app.js`, with font provenance in `assets/fonts/README.md`. It describes the built system rather than the preliminary composition brief. Publication remains subject to instructor or TA review; empty collections are an intentional supported state.",
    "keyCharacteristics": [
      "Warm paper and ink with restrained brick-red actions.",
      "Editorial serif headings paired with system sans interface text.",
      "Flat, ruled collections and a deep olive publication folio.",
      "Honest empty states with clear next actions."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use brick red for actionable links and existing textual emphasis; preserve the olive folio's pale link and focus treatment.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Newsreader for editorial headings and names, and system sans for navigation, instructions, metadata and controls.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate collection content with thin rules and spacing; preserve the flat surface treatment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain paper, ink and brick-red hierarchy with the dark olive folio.",
      "Do keep visible keyboard focus and the reduced-motion alternative.",
      "Do preserve wrapping filters, stacked mobile collections and authored footer line breaks.",
      "Do show honest empty, loading and unavailable states with useful actions."
    ],
    "donts": [
      "Don't invent a university logo or fabricate published work to fill the gallery.",
      "Don't replace the supplied serif headings with a system display face.",
      "Don't imply extra Newsreader weights are bundled with the static font."
    ]
  }
